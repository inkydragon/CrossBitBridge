# Run after MIDL so the notice is restored whenever the files are regenerated.
set(notice "/* Generated by MIDL. DO NOT EDIT. Edit the IDL and rerun scripts/build.ps1. */\n")
foreach(name IN ITEMS bridge.gen.h bridge_c.gen.c bridge_s.gen.c)
  set(path "${GENERATED_DIR}/${name}")
  file(READ "${path}" content)
  string(FIND "${content}" "${notice}" notice_position)
  if(NOT notice_position EQUAL 0)
    file(WRITE "${path}" "${notice}${content}")
  endif()
endforeach()
